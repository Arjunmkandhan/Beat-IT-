VOLUME 75
CALL play_verse(p.note1, p.note2, p.note3)
CALL play_verse(p.note4, p.note5, p.note6)
accompaniment = [p.note7, p.note8, p.note9, p.note10]
FOR chord IN accompaniment:
  PLAY chord, 0, 800, ms
  SLEEP 100 ms
count = 0
WHILE (count < 4):
  PLAY p.note1, 1, 3, s
  SLEEP 250 ms
  PLAY p.note2
  count += 1
FOR i IN range(4):
  PLAY p.note3
  SLEEP 500 ms
FUNCTION play_verse(noteA, noteB, noteC):
  PLAY noteA, 0, 1200, ms
  SLEEP 150 ms
  PLAY noteB, 200, 1500, ms
  SLEEP 150 ms
  PLAY noteC, 500, 2000, ms
  SLEEP 300 ms
