# =============================================================================
# UNIVERSAL .gitignore
# Covers OS, editors, secrets, logs, and most languages/frameworks.
# Lockfiles (package-lock.json, yarn.lock, Cargo.lock, poetry.lock, etc.)
# are intentionally NOT ignored. Commit them.
# =============================================================================

.vscode 
