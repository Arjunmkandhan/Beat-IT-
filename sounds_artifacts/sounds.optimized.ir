VOLUME 80
base = 20
count = 0
song1 = s.C_OldiscoPiano_02_728
song2 = s.Fm_Musicloop_SP_07_406
song3 = s.kick
n1 = p.note1
n2 = p.note2
n3 = p.note3
n4 = p.note4
note_sequence = [n1, n2, n3]
base = getBase(base, 0.5)
CALL play_traid(n1, n2, n3)
SLEEP 2 s
FUNCTION getBase(base, ratio):
  RETURN (base * ratio)
FUNCTION play_traid(notea, noteb, notec):
  PLAY_ASYNC notea
  PLAY_ASYNC noteb
  PLAY_ASYNC notec
